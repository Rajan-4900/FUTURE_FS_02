## Copy this file to .env and fill values before running the server
# MongoDB connection string (Atlas or local). Example: mongodb+srv://user:pass@cluster0.mongodb.net/dbname
MONGODB_URI=

# JWT secret for signing tokens
JWT_SECRET=

# Optional: server port
PORT=5000

# Optional: token expiry
JWT_EXPIRE=7d
NODE_ENV=development
PORT=5000
# URL-encode special chars in password (@ → %40, # → %23, etc.)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/future_crm?appName=crm-cluster
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
# Required when registering additional admins (after the first)
ADMIN_SETUP_KEY=smartlead_admin_2026
